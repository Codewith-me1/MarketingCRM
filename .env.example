# Copy this file to .env and fill in your values.
# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# Only the public "anon" key belongs here. NEVER put the service_role key in a Vite env file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the deployed app (used to build invitation links). Optional.
VITE_APP_URL=

# Display name shown in the UI and in invitation emails.
VITE_APP_NAME=Northstar CRM
