# Copy this file to .env and fill in your values.
# ---- Browser (bundled into the app; safe to be public) ---------------------------------
# Supabase -> Project Settings -> API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# New publishable key (sb_publishable_...). Takes precedence over the legacy anon key below.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_nA-y47EhM6eFwyBibdeJdA_8sk2lIeb

# Legacy anon key (JWT). Only used while VITE_SUPABASE_PUBLISHABLE_KEY is empty; delete it once you
# have switched and disabled legacy keys in Supabase.
VITE_SUPABASE_ANON_KEY=

# Public URL of the deployed app (used for invitation, form and email-confirmation links).
# Leave empty to use the current browser address.
VITE_APP_URL=

# Display name shown in the UI and in invitation emails.
VITE_APP_NAME=Northstar CRM

# ---- Server only (NOT bundled; read by api/successai.js and the dev server) ------------------
# New secret key (sb_secret_...) from Project Settings -> API Keys -> Secret keys.
# Never prefix it with VITE_. Needed for the Success.ai integration.
SUPABASE_SECRET_KEY=sb_secret_ZvEGs5H-TfXtnxJHSs-u7Q_Sg9bjgW1

# The Success.ai API key does NOT go here: an Admin pastes it in the app under
# Campaigns -> Success.ai outreach, and it is stored per workspace in Supabase.
